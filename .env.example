# FleetIQ configuration. Copy to `.env` and edit as needed.
# Every value is optional; the defaults below run the whole stack locally.

# --- Application -----------------------------------------------------------
APP_NAME=FleetIQ
APP_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Storage ---------------------------------------------------------------
# Local SQLite (default) or PostgreSQL. The Docker Compose stack sets this to
# postgresql+psycopg://fleetiq:fleetiq@postgres:5432/fleetiq.
DATABASE_URL=sqlite:///./data/fleetiq.db
DATA_DIR=data
MODEL_DIR=models

# --- MLflow ----------------------------------------------------------------
# Local SQLite tracking store. In Docker Compose point this at the MLflow
# service instead: http://mlflow:5000
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_EXPERIMENT_MAINTENANCE=fleetiq-maintenance-risk
MLFLOW_EXPERIMENT_FREIGHT=fleetiq-freight-pricing
MLFLOW_REGISTERED_MODEL_MAINTENANCE=fleetiq-maintenance-risk
MLFLOW_REGISTERED_MODEL_FREIGHT=fleetiq-freight-pricing
MLFLOW_ENABLED=true

# --- Serving ---------------------------------------------------------------
# local  = load bundles from models/<key>/current
# mlflow = pull the `champion` alias from the MLflow Model Registry
MODEL_SOURCE=local
AUTO_PROMOTE=true
REFERENCE_YEAR=2025

# --- Quality gates ---------------------------------------------------------
MIN_MAINTENANCE_AUC=0.75
MAX_FREIGHT_MAPE=25.0

# --- Monitoring ------------------------------------------------------------
DRIFT_WINDOW=500
PSI_WATCH=0.10
PSI_ALERT=0.25

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
# Leave empty to disable the admin token locally. Set a long random value in
# any shared environment; /api/admin/reload then requires X-Admin-Token.
ADMIN_TOKEN=
PREDICTION_LOG_ENABLED=true
MAX_BATCH_SIZE=500

# --- Optional S3 artefact mirror ------------------------------------------
# S3_BUCKET=fleetiq-models-prod
# S3_PREFIX=fleetiq
# AWS_REGION=ca-central-1

# --- Optional explicit CSV paths ------------------------------------------
# MAINTENANCE_CSV=data/raw/logistics_predictive_maintenanceV2.csv
# SHIPMENTS_CSV=data/raw/logistics_shipments_dataset.csv
